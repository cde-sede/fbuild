# Self-build: funcbuild building its own interpreter.
# Compiles src/*.c -> build/*.o in parallel, links fbuild, writes
# compile_commands.json. nob bootstraps the first binary; after that
#   ./fbuild                  # rebuild (default target)
#   ./fbuild -f               # force a full rebuild
#   ./fbuild --compile-commands
#   ./fbuild plugins          # build plugins/*.c -> build/*.so
#   ./fbuild fbuildd          # build the LSP daemon (opt-in, like plugins)
#   ./fbuild install
#   ./fbuild --help           # generated from the schema below
opts = Parser<{
	"force":    { "type": "bool", "help": "force a full rebuild" },
	"commands": { "type": "bool", "long": "--compile-commands", "help": "write compile_commands.json" },
	"jobs":     { "type": "int", "short": "-j", "default": _ -> to_int(shell(`nproc`)), "help": "parallel compile jobs (-j N, default nproc)" },
	"bench":    { "type": "bool", "help": "print build timing (needs --bench)" },
	"quiet":    { "type": "bool", "short": "-q", "help": "quit mode" },
}>

config({ "jobs": opts.jobs, "silent": opts.quiet })
FORCE    = opts.force
COMMANDS = opts.commands
TARGETS  = opts.rest


EXE    = [fbuild]
SRCS   = filter(glob([src/*.c]), f -> name(f) != 'main_lspd.c')
OBJS   = SRCS |> f -> path([build], cat(stem(f), '.o'))
HDRS   = concat(glob([src/*.h]), glob([cds-lib/cds_lib/*.h]), glob([cds-lib/*.h]), glob([cds-lib/*.c]))
CC     = 'cc'
CFLAGS = '-ggdb', '-Icds-lib', '-Wall', '-Wextra', '-O2', '-U_FORTIFY_SOURCE', '-D_FORTIFY_SOURCE=0'
log    = l, m -> print(cat('[', l, '] ', m))

compile = o, s -> `{CC} {...CFLAGS} -c {...s} -o {.o}`
                  when FORCE or stale(.o, ...s, ...HDRS)
link    = a, d -> `{CC} {...d} -o {.a} -rdynamic -ldl -lm` when FORCE or stale(.a, ...d)

create_cmd = (f, artifact, @deps -> f(.artifact, ...deps))

entry = o, s -> {
	"directory": cwd,
	"file": .s,
	"command": join(concat((CC), CFLAGS, ('-c', .s, '-o', .o)), ' ')
}

units = zip(OBJS, SRCS)
objs  = units |> @u -> create_cmd(compile, ...u)
exe   = create_cmd(link, EXE, OBJS)

PLUGIN_SRCS = glob([plugins/*.c])
PLUGINS     = PLUGIN_SRCS |> f -> path([build], cat(stem(f), '.so'))
plugin_cc   = o, s -> `{CC} -shared -fPIC -Isrc {...CFLAGS} {...s} -o {.o}`
                      when FORCE or stale(.o, ...s, [src/fbuild.h])
plugins     = zip(PLUGINS, PLUGIN_SRCS) |> @u -> create_cmd(plugin_cc, ...u)

mkdir([build])
log("INFO", "Compile commands done!"), json_write([compile_commands.json], units |> u -> create_cmd(entry, ...u)) when COMMANDS

(run(plugins), log("INFO", "plugins built")) when contains(TARGETS, 'plugins')

EXED     = [fbuildd]
LSPD_SRC = [src/main_lspd.c]
LSPD_OBJ = path([build], cat(stem(LSPD_SRC), '.o'))
LIB_OBJS = filter(OBJS, o -> name(o) != 'main.o')
lspd_obj = create_cmd(compile, LSPD_OBJ, LSPD_SRC)
lspd_exe = create_cmd(link, EXED, concat(LIB_OBJS, LSPD_OBJ))


main = (objs >> exe)

(run(objs >> lspd_obj >> lspd_exe), log("INFO", "fbuildd built")) when contains(TARGETS, 'fbuildd')
log("INFO", "{EXE} up to date") when not (
	bench('build', run(main)) when (contains(TARGETS, 'all') or length(TARGETS) == 0) and (FORCE or stale(EXE, ...SRCS, ...OBJS, ...HDRS))
) when not contains(TARGETS, 'install')
log("INFO", "installed!") when (copy(EXE, join((env('PREFIX_INSTALL_PATH') || [/usr/bin], EXE.name), '/')) when contains(TARGETS, 'install')).name != ''
