# Self-build: funcbuild building its own interpreter.
# Compiles src/*.c -> build/*.o in parallel, links fbuild, writes
# compile_commands.json. nob bootstraps the first binary; after that
#   ./fbuild            # rebuilds itself from this script
#   ./fbuild -f         # force a full rebuild
config(map((
	('jobs', to_int(shell('nproc'))),
	('silent', true)
)))
EXE    = [fbuild]
SRCS   = glob([src/*.c])
OBJS   = SRCS |> f -> path([build], cat(stem(f), '.o'))
HDRS   = concat(glob([src/*.h]), glob([cgen/cds_lib/*.h]), glob([cgen/*.h]))
CC     = 'cc'
CFLAGS = '-ggdb', '-Icgen', '-Wall', '-Wextra', '-O2', '-U_FORTIFY_SOURCE', '-D_FORTIFY_SOURCE=0'
log    = l, m -> print(cat('[', l, '] ', m))

FLAGS    = filter(args, e -> starts_with(e, '-'))
FORCE    = (contains(FLAGS, '-f') or contains(FLAGS, '--force'))
COMMANDS = contains(FLAGS, '--compile-commands')


compile = o, s -> `{CC} {...CFLAGS} -c {...s} -o {.o}`
                  when stale(.o, ...s, ...HDRS) or FORCE
link    = a, d -> `{CC} {...d} -o {.a}` when stale(.a, ...d) or FORCE
create_cmd = (f, artifact, @deps -> f(.artifact, ...deps))

entry = o, s -> map((
	('directory', cwd),
	('file', .s),
	('command', join(concat((CC), CFLAGS, ('-c', .s, '-o', .o)), ' '))
))

units = zip(OBJS, SRCS)
objs  = units |> @u -> create_cmd(compile, ...u)
exe   = create_cmd(link, EXE, OBJS)

mkdir([build])
json_write([compile_commands.json], units |> u -> create_cmd(entry, ...u)) when COMMANDS

log("INFO", "{EXE} up to date") when not (
	bench('build', run(objs >> exe))
		when (contains(args, 'all') or length(args) - length(FLAGS) == 0)
			and (stale(EXE, ...SRCS, ...OBJS) or FORCE)
)
copy(EXE, join((env('PREFIX_INSTALL_PATH') || [/usr/bin], EXE.name), '/')) when contains(args, 'install')
