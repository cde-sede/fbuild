mkdir([tmp_opt])
write([tmp_opt/a.c], "int a;\n")
write([tmp_opt/b.c], "int b;\n")
write([tmp_opt/a.d], "tmp_opt/a.o: tmp_opt/a.c tmp_opt/a.h \\\n  tmp_opt/b.h\n")
touch([tmp_opt/a.h])
touch([tmp_opt/b.h])
sleep(20)
touch([tmp_opt/a.o])
print(existsm([tmp_opt/a.c]), existsm([tmp_opt/nope.c]), is_filem([tmp_opt/a.c]), is_dirm([tmp_opt]))
print(globm('tmp_opt/*.c'))
print(depsm([tmp_opt/a.o]))
print(stalem([tmp_opt/a.o], [tmp_opt/a.c]), stalem([tmp_opt/missing.o], [tmp_opt/a.c]))
print(mtimem([tmp_opt/nope]), mtimem([tmp_opt/a.c]) > 0)
print(newest([tmp_opt/a.c], [tmp_opt/a.o]), oldest([tmp_opt/a.c], [tmp_opt/a.o]))
print(hashm([tmp_opt/a.c]) != hashm([tmp_opt/b.c]), hashm([tmp_opt/nope]))
print(cache_load([tmp_opt/cache.txt]), stale_hash([tmp_opt/a.o], [tmp_opt/a.c]))
print(cache_save([tmp_opt/cache.txt]), read([tmp_opt/cache.txt]))
print(stat_reset())
print(cache_load([tmp_opt/cache.txt]), stale_hash([tmp_opt/a.o], [tmp_opt/a.c]))
print(needed(List<([tmp_opt/a.o], [tmp_opt/a.c]), ([tmp_opt/x.o], [tmp_opt/b.c])>))
print(List<"a.c", "b.c", "a.d", "a.h", "b.h", "a.o", "cache.txt"> |> f -> remove(path("tmp_opt", f)), remove([tmp_opt]))
