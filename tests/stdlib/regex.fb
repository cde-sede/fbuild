print(regex.match("hello world", "wor.d"), regex.match("hello world", "xyz"), regex.match("", "^$"))
print(regex.find("abc123def", "[0-9]+"), regex.find("no digits here", "[0-9]+"), regex.find("aaa", "a*"))
print(regex.findall("a1 b22 c333", "[0-9]+"), regex.findall("k=v x=y", "([a-z])=([a-z])"))
print(regex.findall("abc", "x*"), regex.findall("baac", "a*"), regex.findall("aXbX", "^."))
print(regex.groups("2026-07-15", "([0-9]+)-([0-9]+)-([0-9]+)"), regex.groups("no match", "([0-9]+)"))
print(regex.groups("ac", "a(b)?c"), regex.groups("ab", "(a)|(b)"))
print(regex.replace("foo bar foo", "foo", "baz"), regex.replaceall("foo bar foo", "foo", "baz"))
print(regex.replaceall("John Smith", "([A-Za-z]+) ([A-Za-z]+)", "\\2 \\1 [\\0] \\5"))
print(regex.replaceall("abc", "x*", "-"), regex.replaceall("baac", "a*", "-"), regex.replace("x", "y", "z"))
print(regex.split("a, b,  c", ",\\s*"), regex.split("a1b2", "([0-9])"), regex.split("", ","))
print(regex.match("src/a.c", "\.c$"), regex.match("src/b.h", "\.c$"), regex.replace("src/a.c", "^([a-z]+)/", "\1:"))
