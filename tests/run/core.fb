print(split("a,b,,c", ","), join(("x", "y"), "+"), subst("src/main.c", "src/*.c", "build/*.o"))
print([src/main.c] // [*.c] // [*.o])
print(File<*[src/x.c], suffix=".o">, File<*[src/x.c], parent="out", stem="y">)
print(to_int("42abc"), to_float("2.5e1"), to_str(3.0), to_int(9.9))
type Point(x, y) = { x, y }
method Point.sum = self -> self.x + self.y
method Point.prod = (x, y) -> x * y
p = Point(3, 4)
print(p, p.sum(), p.prod(), p.x)
debug(p, 1, 2.0, "s", [f], (1, 2), `echo {p.x}`)
