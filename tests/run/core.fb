_GLOBALS.count <- _GLOBALS.count + 41
print(_GLOBALS.count, _GLOBALS)
print(concat(xs, (4, 5), 6, nil), filter(xs, x -> x > 1), contains(xs, 2), first(xs), last(xs))
print("interp {1 + 1} and {xs}")
c ~= 1
c ~= c + 1
print(c)
print(with_suffix([a/b.c], "o"), with_name([a/b.c], "z.h"), path("a", "", "b"), parent([x]), name("a/b"))
