{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "funcbuild",
      "camelcase": "Funcbuild",
      "title": "Funcbuild",
      "scope": "source.funcbuild",
      "file-types": [
        ".fb"
      ],
      "injection-regex": "^funcbuild$",
      "class-name": "TreeSitterFuncbuild"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "Funcbuild grammar for tree-sitter",
    "authors": [
      {
        "name": "cde-sede",
        "email": "clement.desede@gmail.com",
        "url": "https://github.com/cde-sede"
      }
    ],
    "links": {
      "repository": "https://github.com/tree-sitter/tree-sitter-funcbuild",
      "funding": ""
    }
  },
  "bindings": {
    "c": true,
    "go": true,
    "java": false,
    "node": true,
    "python": true,
    "rust": true,
    "swift": true,
    "zig": false
  }
}