# Snake, in funcbuild, on the auto-generated raylib bindings.
# The host calls main(frame) every frame; state is carried across frames with
# the host's save()/restore() (the language has no mutable global). A cell is a
# single int index  y*COLS + x.

COLS  = 32
ROWS  = 24
CELL  = 25
SPEED = 6                       # advance the snake every SPEED frames
cells = COLS * ROWS

bg    = { "r": 18,  "g": 18,  "b": 28,  "a": 255 }
green = { "r": 80,  "g": 200, "b": 120, "a": 255 }
red   = { "r": 235, "g": 90,  "b": 70,  "a": 255 }
white = { "r": 235, "g": 235, "b": 235, "a": 255 }

K_UP    = KEY_UP()
K_DOWN  = KEY_DOWN()
K_LEFT  = KEY_LEFT()
K_RIGHT = KEY_RIGHT()

one = v -> range(1) |> _ -> v   # single-element list [v]
xof = i -> i % COLS
yof = i -> i / COLS

ceildiv = a, b -> (a + b - 1) / b               # ceil(a/b) with floor division
foods   = len -> ceildiv(len, 10)               # foods on screen = ceil(length/10)
spawn   = n -> range(n) |> _ -> GetRandomValue(0, cells - 1)   # n random cells

init = {
	"body": range(3) |> i -> 400 - i,   # head at (16,12), tail to the left
	"dx": 1, "dy": 0,
	"food": spawn(foods(3)),
	"dead": false,
	"tick": 0
}

# new direction from the arrow keys, refusing a 180-degree reversal
dirpick = s ->
	   ((0, 0 - 1) when (IsKeyPressed(K_UP)    and s.dy == 0))
	|| ((0, 1)     when (IsKeyPressed(K_DOWN)  and s.dy == 0))
	|| ((0 - 1, 0) when (IsKeyPressed(K_LEFT)  and s.dx == 0))
	|| ((1, 0)     when (IsKeyPressed(K_RIGHT) and s.dx == 0))
	|| (s.dx, s.dy)

# between moves: keep the body, just steer + tick
rest = s -> {
	"body": s.body, "food": s.food, "dead": s.dead,
	"dx": (dirpick(s)).0, "dy": (dirpick(s)).1,
	"tick": s.tick + 1
}

# one step: move the head, handle walls / self / food
step = s -> {
	"body": nbody, "food": nfood, "dead": dead,
	"dx": ddx, "dy": ddy, "tick": s.tick + 1
}
	where d = dirpick(s), ddx = d.0, ddy = d.1,
	      hx = xof(first(s.body)) + ddx,
	      hy = yof(first(s.body)) + ddy,
	      nh = hy * COLS + hx,
	      hit = hx < 0 or hx >= COLS or hy < 0 or hy >= ROWS,
	      dead = hit or contains(s.body, nh),
	      ate = contains(s.food, nh),
	      grown = concat(one(nh), s.body),
	      nbody = (grown when ate) || take(grown, length(s.body)),
	      kept = filter(s.food, f -> f != nh),        # drop the eaten one
	      need = max(0, foods(length(nbody)) - length(kept)),
	      nfood = concat(kept, spawn(need))           # replenish to ceil(len/10)

advance = s -> (step(s) when (s.tick % SPEED) == 0) || rest(s)
reset   = s -> (init when s.dead) || s

draw = s -> (
	ClearBackground(bg),
	s.food |> f -> DrawRectangle(xof(f) * CELL, yof(f) * CELL, CELL - 1, CELL - 1, red),
	s.body |> c -> DrawRectangle(xof(c) * CELL, yof(c) * CELL, CELL - 1, CELL - 1, green),
	DrawText(cat('len ', to_str(length(s.body))), 8, 6, 22, white)
)
render = s -> s where drawn = draw(s)

main = frame -> render(save(advance(reset(restore() || init))))
