# Build the funcbuild + raylib host (dogfoods funcbuild to build a funcbuild
# embedder). Regenerates the raylib bindings, compiles, links gfx-auto against
# libfbuild + raylib, and writes compile_commands.json.
#   fbuild            # build (default)
#   fbuild -f         # force a full rebuild
opts  = Parser<{ "force": { "type": "bool", "help": "force a full rebuild" } }>
FORCE = opts.force

RAYLIB = cat(env('HOME'), '/projects/raylib/src')
CC     = 'cc'
CFLAGS = '-I../src', '-I../cds-lib', cat('-I', RAYLIB), '-O2', '-Wall'
LDLIBS = '../libfbuild.a', cat(RAYLIB, '/libraylib.a'),
         '-lGL', '-lm', '-lpthread', '-ldl', '-lrt', '-lX11'

EXE  = [gfx-auto]
SRCS = [app.c], [raylib_gen.c]
OBJS = SRCS |> f -> path([build], cat(stem(f), '.o'))
HDRS = concat(glob([../src/*.h]), glob([../cds-lib/cds_lib/*.h]))

log     = l, m -> print(cat('[', l, '] ', m))
compile = o, s -> `{CC} {...CFLAGS} -c {...s} -o {.o}` when stale(.o, ...s, ...HDRS) or FORCE
link    = a, d -> `{CC} {...d} -o {.a} {...LDLIBS}`     when stale(.a, ...d) or FORCE
create  = (f, art, @deps -> f(.art, ...deps))

entry = o, s -> {
	"directory": cwd,
	"file": .s,
	"command": join(concat((CC), CFLAGS, ('-c', .s, '-o', .o)), ' ')
}

# regenerate the bindings when the generator changed (or the C is missing)
run(`python3 gen_raylib.py`) when stale([raylib_gen.c], [gen_raylib.py])

units = zip(OBJS, SRCS)
objs  = units |> @u -> create(compile, ...u)
exe   = create(link, EXE, OBJS)

mkdir([build])
json_write([compile_commands.json], units |> u -> create(entry, ...u))

log('INFO', '{EXE} up to date') when not run(objs >> exe)
