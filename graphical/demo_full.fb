# Uses the auto-generated raylib bindings (real raylib names). Colors are maps
# with r/g/b/a fields (Color is a value struct). `main` runs every frame.

bg   = { "r": 18,  "g": 18,  "b": 28,  "a": 255 }
blue = { "r": 70,  "g": 150, "b": 230, "a": 255 }
red  = { "r": 235, "g": 90,  "b": 70,  "a": 255 }
white= { "r": 235, "g": 235, "b": 235, "a": 255 }

main = frame -> (
	ClearBackground(bg),
	DrawRectangle(60, 60, 160, 90, blue),
	DrawCircle(frame % 800, 300, 40, red),
	DrawLine(0, 0, 800, 600, white),
	DrawText('funcbuild + raylib (auto)', 200, 20, 26, white),
	DrawFPS(680, 10)
)
