;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Lexical
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

ALPHA      = %x41-5A / %x61-7A
DIGIT      = %x30-39

identifier = ( ALPHA / "_" )
             *( ALPHA / DIGIT / "_" )

number     = integer / float

integer    = 1*DIGIT

float      = 1*DIGIT "." 1*DIGIT

string     = squote-string / dquote-string

squote-string = "'" *( escaped / %x20-26 / %x28-7E ) "'"
dquote-string = DQUOTE *( escaped / %x20-21 / %x23-7E ) DQUOTE

escaped    = "\" %x00-7F

path       = "[" *path-char "]"

path-char  = %x20-5A / %x5C / %x5E-7E
             ; any printable except "]"

command    = "`" *( wsp / command-word / interpolation ) "`"

command-word = 1*( command-char / string )
               ; bash-ish word; quoted strings keep their spaces

command-char = %x21-5F / %x61-7A / %x7C-7E
               ; printable, excludes wsp, "`" (x60) and "{" (x7B)

interpolation = "{" wsp* expression wsp* "}"
               ; explicit interpolation back into the language


;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Program
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

program    = *( statement *( newline ) )
statement  = expression

newline    = CRLF / LF


;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Expressions
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

expression = assignment
           / tuple

assignment = identifier wsp* "=" wsp* expression

; tuple binds looser than everything but assignment; a single element
; (no comma) is just that element. its elements sit below the comma so
; the commas separate rather than nest.
tuple =
        lambda-or-seq
        *( wsp* "," wsp* lambda-or-seq )

lambda-or-seq =
          lambda
        / sequence-expression


;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Sequencing
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

sequence-expression =
        pipe-expression
        *( wsp* ">>" wsp* pipe-expression )


;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Pipeline
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

pipe-expression =
        guarded-expression
        *( wsp* "|>" wsp* guarded-expression )


;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Guards and metadata
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

guarded-expression =
        comparison-expression
        [ wsp+ where-clause ]
        [ wsp+ when-clause ]

where-clause =
        "where" wsp+ bindings

bindings =
        binding *( wsp* "," wsp* binding )

binding =
        identifier wsp* "=" wsp* comparison-expression
        ; below guarded-expression on purpose: a binding value must
        ; not swallow the enclosing where/when guard tail, e.g.
        ;   x where a = 1 when cond
        ; binds `when cond` to the guard, not to `a`

when-clause =
        "when" wsp+ expression


;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Comparisons
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

comparison-expression =
        postfix-expression
        *( wsp* compare-op wsp*
           postfix-expression )

compare-op =
          "<"
        / ">"
        / "<="
        / ">="
        / "=="
        / "!="


;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Postfix and atoms
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

; the tight tier: an atom followed by any run of postfix suffixes.
postfix-expression =
        atom
        *( call-suffix
         / field-suffix
         / constructor-suffix    ; only when the atom is an identifier
         / morphism-suffix )

call-suffix        = "(" [ argument-list ] ")"
field-suffix       = "." field
constructor-suffix = "<" [ constructor-fields ] ">"
morphism-suffix    = wsp* "//" wsp* atom

atom =
          capture-expression
        / projection
        / metadata-expression
        / splat-expression
        / path
        / command
        / string
        / number
        / identifier
        / "(" wsp* expression wsp* ")"     ; lambda / tuple appear here


;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Lambda
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

lambda =
        parameter-list
        wsp* "->"
        wsp* expression

parameter-list =
        parameter
        *( wsp* "," wsp* parameter )

parameter =
          identifier
        / projection
        / capture

capture =
        "@"
      / "@" identifier

projection =
        "." identifier
      / "." integer


;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; File morphisms
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

; morphism is a postfix suffix (see morphism-suffix); the left operand
; is the preceding postfix base, the right is the next atom. typically
; both are paths.
;
; semantics:
; [*.c] // [*.o]
; desugars to File -> File


;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Constructors
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

; constructor is a postfix suffix on an identifier (see
; constructor-suffix). it is told apart from a "<" comparison by
; lookahead: "id <" starts a constructor only when followed by ">",
; "*", or "identifier =".

constructor-fields =
        constructor-field
        *( wsp* "," wsp* constructor-field )

constructor-field =
          "*" postfix-expression
        / identifier wsp* "=" wsp* postfix-expression
        ; values stay below comparison so a "<"/">" inside a field
        ; cannot be confused with the closing ">"


;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Function calls
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

; function-call is a postfix suffix (see call-suffix); the callee is the
; preceding postfix base. argument values bind below the tuple level so
; the commas separate arguments instead of building one tuple argument.

argument-list =
        lambda-or-seq
        *( wsp* "," wsp* lambda-or-seq )


;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Tuples
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

; tuple is defined in the Expressions section (it binds just above
; sequence-expression). semantics:
; a, b, c
; produces Tuple<3>


;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Field access
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

; field access is a postfix suffix (see field-suffix); chained as
; base "." field "." field ...

field =
          identifier
        / integer


;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Capture
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

capture-expression =
        capture


;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Metadata
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

metadata-expression =
        "&" postfix-expression

; examples:
; &file
; &.obj
; &foo.bar


;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Splat
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

splat-expression =
        "..." postfix-expression

; usable both in language and commands; in commands it appears
; inside an interpolation, e.g. `gcc -o app {...OBJ}`


;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; Whitespace
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

wsp = SP / HTAB
