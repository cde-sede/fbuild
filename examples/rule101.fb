# 101 = 0b01100101, indexed by neighbourhood n = 4*left + 2*center + right:
#   n: 0 1 2 3 4 5 6 7
#   b: 1 0 1 0 0 1 1 0
RULE = 1, 0, 1, 0, 0, 1, 1, 0

W = 31           # row width
G = 16           # generations to show

RANGE = n -> (...(RANGE(n - 1) when n > 1), n - 1)

STEP = row -> RANGE(W) |> i ->
    RULE.{4 * row.{i - 1} + 2 * row.{i} + row.{i + 1}}

CELL = c -> cat(('#' when c == 1), ('.' when c == 0))
LINE = row -> print(join(row |> c -> CELL(c), ''))

# show G generations starting from a single live cell in the middle
SEED = RANGE(W) |> i -> (1 when i == 15) + 0
CA   = row, n -> (LINE(row), CA(STEP(row), n - 1)) when n > 0
CA(SEED, G)
