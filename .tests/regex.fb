print(regex.match("hello world", "wor.d"))
print(regex.match("hello world", "xyz"))
print(regex.find("abc123def", "[0-9]+"))
print(regex.find("no digits here", "[0-9]+"))
print(regex.findall("a1 b22 c333", "[0-9]+"))
print(regex.groups("2026-07-15", "([0-9]+)-([0-9]+)-([0-9]+)"))
print(regex.groups("no match", "([0-9]+)"))
print(regex.replace("foo bar foo", "foo", "baz"))
print(regex.replaceall("foo bar foo", "foo", "baz"))
print(regex.replaceall("John Smith", "([A-Za-z]+) ([A-Za-z]+)", "\\2 \\1"))
print(regex.split("a, b,  c", ",\\s*"))
